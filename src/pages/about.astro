---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import { getResume } from "~/lib/resume.js";

const resume = await getResume();
---

<StarlightPage frontmatter={{ title: "About Me", description: "Who writes Overfit, and the longer story." }}>
    <div class="about-bio">
        <p>
            I have a theory: the people most confident they understand the wave are usually the ones who didn't see
            the reef. The reef doesn't care how certain you were. Overfit is my attempt to understand why — and to
            get better at reading the break.
        </p>
        <p class="about-sep">· · ·</p>
        <p>
            Outside of work I spend my time losing at board games with good friends, raising three sons who keep me
            honest, and married to a woman who has watched me be confidently wrong enough times to deserve a medal.
        </p>
        <p class="about-sep">· · ·</p>
        <p>The longer story:</p>
    </div>

    <div class="not-content">
        <Fragment set:html={resume.content} />
    </div>
</StarlightPage>

<style is:global set:html={resume.styles}></style>

<style is:global>
    #resume {
        color: var(--sl-color-text);
        background-color: var(--sl-color-bg);
    }
    #resume a,
    #resume .section h2 {
        color: var(--sl-color-text-accent);
    }
    .about-sep {
        text-align: center;
        color: var(--sl-color-gray-3);
    }
</style>
