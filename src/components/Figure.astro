---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
    src: ImageMetadata;
    alt: string;
    sizes?: string;
    caption?: string;
    credit?: string;
}

const { src, alt, sizes = "100vw", caption, credit } = Astro.props;

// Captions and credits accept [text](url) links.
const mdLinks = (text: string) => text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
---

<figure class="picture">
    <Picture src={src} alt={alt} sizes={sizes} widths={[320, src.width]} formats={["webp"]} />
    {
        (caption || credit) && (
            <figcaption>
                {caption && <Fragment set:html={mdLinks(caption)} />}
                {credit && <small class="credit" set:html={mdLinks(credit)} />}
            </figcaption>
        )
    }
</figure>
