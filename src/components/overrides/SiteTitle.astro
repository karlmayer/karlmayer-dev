---
// Overfit wordmark, sized to sit in Nova's single-row header. The tagline lives on the home page.
---

<a href="/" class="wordmark">
    <span class="wordmark-title">Overfit</span>
    <span class="wordmark-author">by Karl Mayer</span>
</a>

<style>
    .wordmark {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        text-decoration: none;
        white-space: nowrap;
    }

    .wordmark-title {
        font-family: var(--overfit-accent-font);
        font-size: 1.6rem;
        line-height: 1;
        letter-spacing: -0.01em;
        color: var(--sl-color-white);
    }

    .wordmark-author {
        font-size: var(--sl-text-sm);
        font-style: italic;
        color: var(--sl-color-gray-3);
    }

    @media (width < 30rem) {
        .wordmark-author {
            display: none;
        }
    }
</style>
